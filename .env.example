# Copy to .env and fill in values
# Supabase connection string — get from: Supabase Dashboard → Project → Settings → Database → Connection string (URI)
# Use "Session mode" pooler (port 5432) for compatibility with Go's lib/pq driver
DATABASE_URL=postgresql://postgres:[your-password]@db.[project-ref].supabase.co:5432/postgres
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_TOKEN=your_line_channel_token
G_API_KEY=your_gemini_api_key
FRONTEND_URL=http://localhost:3000
PORT=8080
